# Compose environment template.
#
# Required before `docker compose up` (compose reads .env automatically):
#   cp env.sample .env
#
# Never commit the real .env: it is gitignored on purpose.

# --- Published port ---------------------------------------------------------
# The SPA is reached as http://<server-ip>:<port>. 3201 is already taken by the
# adulto mayor platform on this VPS, so 3202 is the default here.
FRONTEND_PORT=3202

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=followup
# Generate a real one: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-before-deploying
POSTGRES_DB=followup

# --- Auth -------------------------------------------------------------------
# Generate a real one: openssl rand -hex 32
JWT_SECRET=change-me-before-deploying
# SECONDS, positive integer only (auth.config.ts throws otherwise). 86400 = 24 h.
JWT_EXPIRES_IN=86400

# Origin the API accepts browser calls from. Same origin through nginx, so this
# only matters for direct API calls: http://<server-ip>:3202 in production.
FRONTEND_URL=http://localhost:3202

# --- Credential throttling ---------------------------------------------------
# Positive integers. They gate login and registration per address; the defaults
# below are what runs when the variables are absent, so leaving them out is safe.
# The e2e suite raises the limit because it logs in far more often than a human.
# AUTH_THROTTLE_LIMIT=5
# AUTH_THROTTLE_TTL_SECONDS=60

# --- Reverse proxy -----------------------------------------------------------
# How many proxy hops sit in front of the backend. 1 = the host nginx: req.ip
# becomes the real client and the throttle budgets per client instead of per
# deployment. 0 = trust nobody: only correct when the backend is reached
# directly, because trusting forwarded headers while being directly reachable
# lets an attacker rotate fake IPs to evade the throttle.
# TRUST_PROXY_HOPS=1
