# Copiá este archivo a .env y completá los valores reales.
# .env NUNCA se versiona (ver .gitignore).

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://usuario:password@localhost:5432/follow_up?schema=public"

# --- Autenticación ---
# Generá un secreto nuevo con: openssl rand -base64 48
JWT_SECRET="cambiame-por-un-secreto-aleatorio-de-al-menos-32-caracteres"
JWT_EXPIRES_IN="1d"

# --- Servidor ---
PORT=3000
FRONTEND_URL="http://localhost:4200"
