generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user{
  id Int @id @default(autoincrement())
  full_name String
  email String @unique
  password String 
  created_at DateTime
}

model Folder{
  id Int @id @default(autoincrement())
  name String 
  
}





